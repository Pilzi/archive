{
  "manifest_version": 3,
  "name": "Twitch Speedrun V1",
  "description": "Browser Extension that helps you being the fastest on twitch",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version": "1.0",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "identity",
    "webRequest"
  ],
  "action": {
    "default_title": "Twitch Speedrun V1",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
